# Copy this file to .env.local (local development) and fill in the values.
# On a host (Vercel, Hostinger, GoDaddy, ...) add the same names as
# environment variables in the hosting dashboard instead.
# Never commit real values: .env.local is git-ignored.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...).
# Server-only. Do NOT use the publishable key, and never add a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Only for hosts that run several copies of the site at once (load-balanced or
# multi-instance). Any long random string; keep it the same on every instance.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
